# halpradio — Interactive terminal demo
Output docs/images/demo.gif
Set FontSize 13
Set Width 1050
Set Height 620

Type "./halpradio -backend native -discord=false -notifications=false -mpris=false -ipc=false"
Enter
Sleep 2s

# Select a work mode from the sidebar
Down
Sleep 500ms

# Browse the station catalog
Type "2"
Sleep 700ms
Down 2
Sleep 400ms

# Back to activities, open the WhichKey overlay
Type "1"
Sleep 400ms
Type "?"
Sleep 1500ms
Escape
Sleep 300ms

# Open the theme picker and switch to Synthwave
Type "t"
Sleep 800ms
Type "3"
Sleep 800ms
Escape
Sleep 300ms

Type "q"
Sleep 500ms
